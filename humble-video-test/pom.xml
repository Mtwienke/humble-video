<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.humble</groupId>
    <artifactId>humble-video-parent</artifactId>
    <version>0.3.0</version>
    <relativePath>../humble-video-parent/pom.xml</relativePath>
  </parent>

  <artifactId>humble-video-test</artifactId>
  <packaging>jar</packaging>

  <name>humble-video-test</name>
  <description>A project for doing exhaustive integration tests on Humble Software's video manipulation library.</description>
  <url>http://www.humble.io</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.humble</groupId>
      <artifactId>humble-video-noarch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>Windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-i686-w64-mingw32-debug</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-x86_64-w64-mingw32-debug</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>Mac-ARM64</id>
      <activation>
        <os>
          <family>Mac</family>
        </os>
        <property>
          <name>os.arch</name>
          <value>aarch64</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-arm64-apple-darwin-debug</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.0.0-M5</version>
            <configuration>
              <systemPropertyVariables>
                <java.library.path>
                  ${project.basedir}/../humble-video-stage/humble-video-arch-arm64-apple-darwin/target/native/lib
                </java.library.path>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    
    <profile>
      <id>Mac-x86_64</id>
      <activation>
        <os>
          <family>Mac</family>
        </os>
        <property>
          <name>os.arch</name>
          <value>x86_64</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-x86_64-apple-darwin18-debug</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    
    <profile>
      <id>Mac</id>
      <activation>
        <os>
          <family>Mac-outdated</family>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-x86_64-apple-darwin18-debug</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>Linux</id>
      <activation>
        <os>
          <family>Linux</family>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-i686-pc-linux-gnu6-debug</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>io.humble</groupId>
          <artifactId>humble-video-arch-x86_64-pc-linux-gnu6-debug</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
